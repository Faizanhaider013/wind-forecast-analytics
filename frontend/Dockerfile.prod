# Production image: build the Vite bundle, then serve the static files with Nginx.

# --- build stage ---
FROM node:22-slim AS build
WORKDIR /app

# Install dependencies from the lockfile for reproducible builds.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# No VITE_API_BASE_URL is set, so the client uses a relative base URL and the
# browser calls /api and /health on its own origin (proxied by Nginx below).
RUN npm run build

# --- runtime stage ---
FROM nginx:1.27-alpine AS runtime
# SPA + API-proxy config (history fallback, /api and /health -> backend).
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
# nginx:alpine's default CMD starts nginx in the foreground.
