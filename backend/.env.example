# Backend environment variables (copy to .env and adjust as needed).
# No secrets are required.

# Comma-separated list of browser origins allowed by CORS.
# Honoured by app/main.py; defaults to the Vite dev origin when unset.
# For production, set this to the deployed frontend origin(s), e.g.:
#   CORS_ORIGINS=https://wind.example.com,https://admin.wind.example.com
# CORS_ORIGINS=http://localhost:5173

# Directory for the SQLite database and raw API cache. Compose sets this to
# /app/data (a mounted volume). Defaults to the repo's data/ directory locally.
# WIND_DATA_DIR=/app/data
